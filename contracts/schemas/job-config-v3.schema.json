{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anima://contracts/job-config-v3",
  "type": "object",
  "required": ["schemaVersion", "profile", "workMode", "overwriteMode", "sourceRoot", "annotationBackup", "recursive", "captionFormat", "imageDecode", "caption", "classify", "replace", "nl", "countReview", "dropout", "export"],
  "properties": {
    "schemaVersion": {"const": 3},
    "profile": {"enum": ["e621", "danbooru"]},
    "workMode": {"enum": ["in_place", "full_copy"]},
    "overwriteMode": {"enum": ["incremental", "rebuild"]},
    "sourceRoot": {"type": "string", "minLength": 1},
    "outputRoot": {"type": ["null", "string"], "minLength": 1},
    "annotationBackup": {"const": "required"},
    "recursive": {"type": "boolean"},
    "captionFormat": {
      "type": "object",
      "required": ["replaceUnderscoresWithSpaces", "preserveEscapes", "triggersEnabled", "triggerTerms"],
      "properties": {
        "replaceUnderscoresWithSpaces": {"type": "boolean"},
        "preserveEscapes": {"type": "boolean"},
        "triggersEnabled": {"type": "boolean"},
        "triggerTerms": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      },
      "additionalProperties": false
    },
    "imageDecode": {
      "type": "object",
      "required": ["extensions", "rejectMultiFrame", "applyExifTranspose", "alphaBackground"],
      "properties": {
        "extensions": {"const": [".jpg", ".jpeg", ".png", ".webp", ".bmp"]},
        "rejectMultiFrame": {"const": true},
        "applyExifTranspose": {"const": true},
        "alphaBackground": {"const": "#FFFFFF"},
        "invalidImageAction": {"enum": ["block", "skip"]}
      },
      "additionalProperties": false
    },
    "caption": {
      "type": "object",
      "required": ["enabled", "thresholdMode", "overwriteTxt"],
      "properties": {
        "enabled": {"type": "boolean"},
        "thresholdMode": {"enum": ["model_default", "uniform", "per_category"]},
        "uniformThreshold": {"type": "number", "minimum": 0, "maximum": 1},
        "categoryThresholds": {
          "type": "object",
          "required": ["general", "character", "species", "rating"],
          "properties": {
            "general": {"type": "number", "minimum": 0, "maximum": 1},
            "character": {"type": "number", "minimum": 0, "maximum": 1},
            "species": {"type": "number", "minimum": 0, "maximum": 1},
            "rating": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "overwriteTxt": {"type": "boolean"},
        "resourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "resourceManifestRelativePath": {"type": "string", "minLength": 1, "maxLength": 16384},
        "resourceFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {"if": {"properties": {"thresholdMode": {"const": "model_default"}}, "required": ["thresholdMode"]}, "then": {"not": {"anyOf": [{"required": ["uniformThreshold"]}, {"required": ["categoryThresholds"]}]}}},
        {"if": {"properties": {"thresholdMode": {"const": "uniform"}}, "required": ["thresholdMode"]}, "then": {"required": ["uniformThreshold"], "not": {"required": ["categoryThresholds"]}}},
        {"if": {"properties": {"thresholdMode": {"const": "per_category"}}, "required": ["thresholdMode"]}, "then": {"required": ["categoryThresholds"], "not": {"required": ["uniformThreshold"]}}}
      ],
      "additionalProperties": false
    },
    "classify": {
      "type": "object",
      "required": ["enabled", "overwriteJson", "overwriteCount", "wikiDataSourceId"],
      "properties": {
        "enabled": {"type": "boolean"},
        "overwriteJson": {"type": "boolean"},
        "overwriteCount": {"type": "boolean"},
        "wikiDataSourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "resourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "resourceManifestRelativePath": {"type": "string", "minLength": 1, "maxLength": 16384},
        "resourceFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "replace": {
      "type": "object",
      "required": ["enabled", "indexMode"],
      "properties": {
        "enabled": {"type": "boolean"},
        "indexMode": {"enum": ["bundled", "custom"]},
        "customIndexPath": {"type": "string", "minLength": 1},
        "customIndexSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "customIndexRuleCount": {"type": "integer", "minimum": 1},
        "resourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "resourceManifestRelativePath": {"type": "string", "minLength": 1, "maxLength": 16384},
        "resourceFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {"if": {"properties": {"indexMode": {"const": "bundled"}}, "required": ["indexMode"]}, "then": {"not": {"anyOf": [{"required": ["customIndexPath"]}, {"required": ["customIndexSha256"]}, {"required": ["customIndexRuleCount"]}]}}},
        {"if": {"properties": {"indexMode": {"const": "custom"}}, "required": ["indexMode"]}, "then": {"required": ["customIndexPath"], "not": {"anyOf": [{"required": ["resourceId"]}, {"required": ["resourceManifestRelativePath"]}, {"required": ["resourceFingerprint"]}]}}}
      ],
      "additionalProperties": false
    },
    "nl": {
      "type": "object",
      "required": ["enabled", "reuseOriginalNl", "apiEnabled", "useImage", "useFullJson", "systemPrompt", "promptVersion"],
      "properties": {
        "enabled": {"type": "boolean"},
        "reuseOriginalNl": {"type": "boolean"},
        "apiEnabled": {"type": "boolean"},
        "useImage": {"type": "boolean"},
        "useFullJson": {"type": "boolean"},
        "systemPrompt": {"type": "string", "maxLength": 65536},
        "promptVersion": {"const": "nl-default-prompt-v2"},
        "apiProfileId": {"type": "string", "minLength": 1, "maxLength": 128},
        "apiPolicy": {
          "type": "object",
          "description": "ROADMAP.md:884-937 NlApiPolicy. Every key is optional; core/src/anima_core/nl_runner.py:DEFAULT_POLICY fills the rest and rejects unknown keys.",
          "properties": {
            "concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
            "maxRequestsPerMinute": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 100000}, {"const": "unlimited"}]},
            "maxHttpAttempts": {"type": "integer", "minimum": 1, "maximum": 10000000},
            "mainAttempts": {"type": "integer", "minimum": 1, "maximum": 3},
            "backupEnabled": {"type": "boolean"},
            "backupAttempts": {"type": "integer", "minimum": 1, "maximum": 2},
            "connectTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 120},
            "writeTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 120},
            "readTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
            "poolTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 120},
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "topP": {"type": "number", "minimum": 0, "maximum": 2},
            "maxTokens": {"type": "integer", "minimum": 1, "maximum": 16384},
            "maxImagePixels": {"const": 8000000},
            "maxImageSide": {"const": 4096},
            "jpegQuality": {"const": 95},
            "maxEncodedImageBytes": {"const": 12582912},
            "maxJsonContextBytes": {"const": 262144},
            "maxResponseBodyBytes": {"const": 1048576},
            "maxNlBytes": {"const": 16384}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {"if": {"properties": {"apiEnabled": {"const": true}}, "required": ["apiEnabled"]}, "then": {"properties": {"useImage": {"const": true}}, "required": ["useImage"]}}
      ],
      "additionalProperties": false
    },
    "countReview": {
      "type": "object",
      "required": ["enabled", "protocolVersion"],
      "properties": {
        "enabled": {"type": "boolean"},
        "protocolVersion": {"const": "count-review-v1"}
      },
      "additionalProperties": false
    },
    "dropout": {
      "type": "object",
      "description": "dropNl + dropAppearance must not exceed 1 in any count group; JSON Schema cannot express that sum, contracts.validate_job_config enforces it.",
      "required": ["enabled", "policyVersion", "seed", "artist", "quality", "appearanceNl"],
      "properties": {
        "enabled": {"type": "boolean"},
        "policyVersion": {"const": "dataset-batch-policy-v1"},
        "seed": {"type": "string", "minLength": 1, "maxLength": 256},
        "artist": {
          "type": "object",
          "required": ["enabled", "dropoutProbability"],
          "properties": {"enabled": {"type": "boolean"}, "dropoutProbability": {"type": "number", "minimum": 0, "maximum": 1}, "addAtPrefix": {"type": "boolean"}},
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "required": ["enabled", "dropoutProbability", "device", "batchSize"],
          "properties": {
            "enabled": {"type": "boolean"},
            "dropoutProbability": {"type": "number", "minimum": 0, "maximum": 1},
            "device": {"enum": ["auto", "cuda", "cpu"]},
            "batchSize": {"type": "integer", "minimum": 1, "maximum": 16},
            "resourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
            "resourceManifestRelativePath": {"type": "string", "minLength": 1, "maxLength": 16384},
            "resourceFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "appearanceNl": {
          "type": "object",
          "required": ["enabled", "solo", "nonSolo", "unknown"],
          "properties": {
            "enabled": {"type": "boolean"},
            "solo": {"$ref": "#/$defs/coupledProbabilities"},
            "nonSolo": {"$ref": "#/$defs/coupledProbabilities"},
            "unknown": {"$ref": "#/$defs/coupledProbabilities"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "required": ["format"],
      "properties": {"format": {"enum": ["json", "flat_txt", "both"]}},
      "additionalProperties": false
    }
  },
  "$defs": {
    "coupledProbabilities": {
      "type": "object",
      "required": ["dropNl", "dropAppearance"],
      "properties": {
        "dropNl": {"type": "number", "minimum": 0, "maximum": 1},
        "dropAppearance": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"workMode": {"const": "in_place"}}, "required": ["workMode"]}, "then": {"properties": {"outputRoot": {"type": "null"}}}},
    {"if": {"properties": {"workMode": {"const": "full_copy"}}, "required": ["workMode"]}, "then": {"required": ["outputRoot"], "properties": {"outputRoot": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"countReview": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}}, "required": ["countReview"]}, "then": {"properties": {"classify": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}}}}
  ],
  "additionalProperties": false
}
